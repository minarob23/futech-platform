{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/futech-platform run dev",
    "start": "pnpm --filter @workspace/futech-platform run dev",
    "build": "pnpm --filter @workspace/futech-platform run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "body-parser": ">=2.4.0",
      "qs": ">=6.16.1"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
